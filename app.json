    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.829652266393-7fodrkmnen992pg7a2nknq9k7vb6ie6n"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8d494e58-c72c-474b-bdc9-f73470e80d38"
      }
    }
  }
}
